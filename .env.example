# Every environment variable the code reads, with no values.
# tests/test_env_example.py fails when the code reads one not listed here.
#
# Copy to .env and fill in only what you use. Nothing loads .env into the api
# or the worker: they read their process environment and nothing else. The
# commands that read production load .env themselves and read
# PRODUCTION_DATABASE_URL, never DATABASE_URL.

# --- Production: read only by commands that name production ---------------
# make profile, make profile-check, make testdb-sync. To point any other
# command at production on purpose: DATABASE_URL="$PRODUCTION_DATABASE_URL" ...
PRODUCTION_DATABASE_URL=

# --- Local and test databases: export in your shell, not here -------------
# This checkout's disposable test database. `eval "$(make testdb-url)"` sets it.
# TEST_DATABASE_URL=
# Where dev-api, dev-worker and migrate point. Defaults to the test database
# above; set it to the synced copy's dev role (make testdb-sync) for real rows.
# JOBTRACKER_DEV_DATABASE_URL=

# --- The application's process environment ---------------------------------
# Set by the fleet's compose files, or by the Makefile's dev targets. Listed
# for reference and commented out: putting DATABASE_URL in .env is what used
# to point local commands at production.
#
# Required
# DATABASE_URL=
# JOBTRACKER_SERVICE_TOKEN=
# APP_ENCRYPTION_KEY=
#
# Model providers (the shared key for budgeted users and ingestion)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
# OPENAI_ADMIN_KEY=
# OPENAI_BILLING_PROJECT_IDS=
#
# Object storage for payloads
# JOBTRACKER_S3_ENDPOINT=
# JOBTRACKER_S3_REGION=
# JOBTRACKER_S3_BUCKET=
# JOBTRACKER_S3_ACCESS_KEY_ID=
# JOBTRACKER_S3_SECRET_ACCESS_KEY=
#
# Identity, mail and Gmail
# JOBTRACKER_ADMIN_GROUPS=
# JOBTRACKER_OWNER_KEY_MODELS=
# AUTHENTIK_URL=
# AUTHENTIK_INVITE_TOKEN=
# AUTHENTIK_INVITE_FLOW=
# AUTHENTIK_INVITE_FLOW_PK=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GMAIL_OAUTH_REDIRECT_URIS=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# JOBTRACKER_MAIL_FROM=
# JOBTRACKER_APP_URL=
# CENTRIFUGO_API_URL=
# CENTRIFUGO_API_KEY=
#
# Telemetry and identity of this process
# POSTHOG_API_KEY=
# POSTHOG_HOST=
# POSTHOG_TRACE_SAMPLE=
# POSTHOG_LOG_LEVEL=
# JOBTRACKER_ENV=
# JOBTRACKER_REVISION=
# JOBTRACKER_WORKER_NAME=
# JOBTRACKER_HOST_NAME=
# JOBTRACKER_EGRESS_GROUP=
# JOBTRACKER_METRICS_PORT=
# PORT=
# CONFIG_NAME=
#
# Per-host worker knobs (defaults in the code that reads each one). Fleet-wide
# tunables are app_config rows, changed from the admin config page.
# JOBTRACKER_DB_POOL_MAX=
# JOBTRACKER_WORKER_POLL=
# JOBTRACKER_WORKER_KINDS=
# JOBTRACKER_WORKER_EXCLUDE_KINDS=
# JOBTRACKER_TASK_SLOTS=
# JOBTRACKER_INGEST_SCHEDULER=
# JOBTRACKER_MAX_CONCURRENCY=
# JOBTRACKER_SCRAPE_CONCURRENCY=
# JOBTRACKER_SCRAPE_TIMEOUT_SECONDS=
# JOBTRACKER_BATCH_POLL_MINUTES=
# JOBTRACKER_BATCH_WAVE_CONCURRENCY=
# JOBTRACKER_REQUIREMENTS_MODEL=
# JOBTRACKER_IMPROVE_MODEL=
# JOBTRACKER_MAIL_BACKFILL_MODEL=
# JOBTRACKER_MAIL_ONGOING_MODEL=
# JOBTRACKER_MAIL_IMPORT_FLUSH=
# JOBTRACKER_MAIL_SYNC_OVERLAP_DAYS=
