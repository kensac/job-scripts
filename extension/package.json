{
  "name": "job-tracker-apply",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/entrypoints.mjs && wxt",
    "build": "node scripts/entrypoints.mjs && wxt build",
    "zip": "node scripts/entrypoints.mjs && wxt zip",
    "preview:build": "node scripts/preview.mjs",
    "test:e2e": "npm run preview:build && playwright test",
    "typecheck": "node scripts/entrypoints.mjs && wxt prepare && tsc --noEmit",
    "test": "node --import tsx --test ../tests/extension/*.test.cjs tests/*.test.ts",
    "postinstall": "node scripts/entrypoints.mjs && wxt prepare"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/chrome": "0.3.0",
    "@types/node": "24.13.6",
    "esbuild": "0.28.2",
    "happy-dom": "20.14.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "wxt": "0.21.4"
  },
  "overrides": { "esbuild": "0.28.2" }
}
